# TerraForte — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase ────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ─────────────────────────────────────────────────────
VITE_APP_NAME=TerraForte
VITE_APP_URL=https://terraforte.app

# ── Feature Flags ────────────────────────────────────────────
# Set to "true" to enable Gov.BR OAuth2 integration
VITE_ENABLE_GOVBR=false

# ── Asaas Payments (optional) ────────────────────────────────
# Found at: Asaas Dashboard → Integrations → API Keys
# Use the SANDBOX key for development
VITE_ASAAS_API_KEY=
VITE_ASAAS_SANDBOX=true
